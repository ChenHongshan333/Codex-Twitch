{
  "name": "chatcrossfire",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.mjs",
    "dev": "node --watch --env-file-if-exists=.env server.mjs",
    "bot": "node --env-file=.env bot.mjs",
    "verify:twitch": "node --env-file-if-exists=.env scripts/verify-twitch.mjs",
    "test": "node --test",
    "check": "node --check server.mjs && node --check src/engine.mjs && node --check src/twitch.mjs && node --check src/store.mjs && node --check public/app.js"
  },
  "devDependencies": {
    "jsdom": "^29.1.1"
  }
}
