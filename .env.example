# Beginner guide: docs/configuration-guide.md
# Your Developer Application Client ID/Client Secret are NOT pasted below.
# Current backend derives the app Client ID by validating the user token and
# does not read an app Client Secret variable. Obtain a USER access token via
# the official Twitch consent flow/CLI, then store only that token here.
TWITCH_OAUTH_TOKEN=PASTE_NEW_TOKEN_HERE

# Optional local defaults. Existing token-only .env files continue to work.
PORT=3000
HOST=127.0.0.1
# Set a stable host key (24+ characters), or let the server generate one per launch.
# ADMIN_KEY=replace-with-a-long-random-private-key
# For remote streamers, deploy behind HTTPS and set the exact public origin.
# HOST=0.0.0.0
# PUBLIC_ORIGIN=https://your-domain.example

# Native Twitch Extension (separate from the chatbot OAuth app).
# Developer Console > Extensions, not Applications. The application Client
# Secret cannot be used as TWITCH_EXTENSION_SECRET.
# Copy the Extension Client ID and Base64 shared secret from the Extension console.
TWITCH_EXTENSION_ID=
TWITCH_EXTENSION_SECRET=
# Optional exact local-test frontend origins, comma-separated. The Twitch CDN origin
# https://<extension-id>.ext-twitch.tv is allowed automatically.
EXTENSION_ALLOWED_ORIGINS=
# Keep disabled on all public deployments. npm run sandbox enables loopback testing.
ENABLE_SANDBOX=0
SANDBOX_PORT=3010
# Separate loopback OBS dodge prototype. Synthetic input unless explicitly enabled.
DODGE_PORT=3020
DODGE_LIVE=0
DODGE_CHANNEL_A=
DODGE_CHANNEL_B=
# Optional broadcaster-owned user tokens; fill privately, never in chat/docs.
# Scopes: bits:read and/or channel:read:subscriptions. See docs/dodge-runbook.md.
DODGE_SUPPORT_TOKEN_A=
DODGE_SUPPORT_TOKEN_B=
# Public deployment: explicitly disable legacy debug controls.
# ENABLE_DEBUG=0
