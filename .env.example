TWITCH_OAUTH_TOKEN=PASTE_NEW_TOKEN_HERE

# Optional. Existing .env files with only TWITCH_OAUTH_TOKEN continue to work.
PORT=3000
HOST=127.0.0.1
# Set a stable host key (24+ characters), or let the server generate one per launch.
# ADMIN_KEY=replace-with-a-long-random-private-key
# For remote streamers, deploy behind HTTPS and set the exact public origin.
# HOST=0.0.0.0
# PUBLIC_ORIGIN=https://your-domain.example
